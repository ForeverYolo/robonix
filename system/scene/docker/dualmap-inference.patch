+def _mask_intersections(left, right):
+    # Count booleans without retaining full-resolution float copies of either stack.
+    result = np.empty((len(left), len(right)), dtype=np.float32)
+    for i, mask in enumerate(left):
+        for j, other in enumerate(right):
+            result[i, j] = np.count_nonzero(mask & other)
+    return result
